{
  "folders": [
    {
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "4ops.terraform",
      "mohsen1.prettify-json",
      "ms-kubernetes-tools.vscode-kubernetes-tools",
      "donjayamanne.githistory",
      "Tim-Koehler.helm-intellisense"
    ]
  },
  "settings": {
    "explorer.compactFolders": false,
    "editor.indentSize": 2,
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "files.exclude": {
      "**/.terraform": true,
      "**/.terraform.lock.hcl": true
    },
    "files.associations": {
      "*.yaml.gotmpl": "helm"
    }
  },
}